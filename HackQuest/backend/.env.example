# Backend Environment Variables
# Copy this to .env and fill in the values

# Database
DATABASE_URL="postgresql://campusfixit:campusfixit_secret@localhost:5432/campusfixit"

# Redis
REDIS_URL="redis://localhost:6379"

# MinIO (S3-compatible storage)
MINIO_ENDPOINT="localhost"
MINIO_PORT="9000"
MINIO_ACCESS_KEY="campusfixit"
MINIO_SECRET_KEY="campusfixit_secret"
MINIO_BUCKET="issues"
MINIO_USE_SSL="false"

# JWT
JWT_SECRET="your-super-secret-jwt-key-change-in-production-at-least-32-chars"
JWT_EXPIRES_IN="7d"

# Server
PORT="4000"
HOST="0.0.0.0"
NODE_ENV="development"

# Escalation Settings (in hours)
ESCALATION_THRESHOLD_HOURS="48"
CRITICAL_ESCALATION_HOURS="24"
